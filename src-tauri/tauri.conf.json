{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lan-maintenanceapp",
  "version": "0.1.0",
  "identifier": "com.root.lan-maintenanceapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "devtools": true,
        "title": "lan-maintenanceapp",
        "width": 800,
        "height": 600,
        "url": "/",
        "highPrivilege": true
      }
    ]
  },
  "bundle": {
    "externalBin": [
      "binaries/network-engine"
    ],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "drivers/npcap-installer.exe"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libpcap0.8"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsi"
      }
    }
  },
  "plugins": {
    "shell": {}
  }
}